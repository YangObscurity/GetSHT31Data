# ==============================================================================
# sdkconfig.defaults
# Target: ESP32 (Fixed basic firmware configurations)
# ==============================================================================

# --- FreeRTOS Kernel & Cadence (U1 / U2) ---
CONFIG_FREERTOS_HZ=100
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set

# --- Power Management & CPU Clock (U3) ---
# CONFIG_PM_ENABLE is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# --- Wi-Fi MAC / PHY Invariants (U3) ---
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y

# --- SNTP Clock Synchronization (U4) ---
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=600000
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set

# --- Logging & UART Overhead Reduction ---
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- Compiler Optimization & Execution Time Consistency ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# --- Network Sockets & Keep-Alive (U5) ---
CONFIG_LWIP_MAX_SOCKETS=10
